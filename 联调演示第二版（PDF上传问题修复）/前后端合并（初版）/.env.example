# 复制为 .env 后填写。.env 不入库；密钥只放在这里或系统环境变量里，不要写进代码、文档和聊天记录。
# 留空或保持 xxxx 表示“未配置”，对应功能自动走降级方案（见 docs/后端使用说明.md）。

# ---------- 外部服务（变量名与 参考代码/config.py 一致，参考后端也读这些变量）----------
# 大模型（OpenAI 兼容的 chat/completions 完整地址），用于旁白生成和有依据问答。
# 本地默认：先运行 scripts/start_llm.ps1 启动 Qwen3-4B-Instruct-2507（llama.cpp），再填下面三行；
# 也可以换成任何 OpenAI 兼容服务（DeepSeek、百炼等）。
SIMPLE_STORY_WRITER_URL=http://127.0.0.1:8080/v1/chat/completions
SIMPLE_STORY_WRITER_API_KEY=
SIMPLE_STORY_WRITER_MODEL=qwen3-4b-instruct-2507

# ---------- 有依据问答（/qa/ask）----------
# PBSC_QA_TOP_K=4              # 检索后最多喂给模型几页
# PBSC_QA_MAX_CHARS=160        # 回答字数上限（儿童口语短句）
# PBSC_QA_TEMPERATURE=0.2      # 问答温度；越高越发散，越低越贴原文
# PBSC_QA_TTS=1                # 回答是否走 CosyVoice 生成音频

# 语音合成（参考代码的 TTS 推理地址），用于旁白配音
TTS_API_URL=xxxx

# ---------- 语音合成服务选择 ----------
# reference：使用上面的 TTS_API_URL；cosyvoice：使用阿里云百炼 CosyVoice WebSocket
# PBSC_TTS_PROVIDER=reference
# COSYVOICE_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# COSYVOICE_API_KEY=xxxx        # 留空则复用 DASHSCOPE_API_KEY；Key 只放本地
# COSYVOICE_WORKSPACE_ID=       # 留空则复用 DASHSCOPE_WORKSPACE_ID
# COSYVOICE_REGION=cn-beijing
# COSYVOICE_MODEL=cosyvoice-v3-plus
# COSYVOICE_VOICE=longanyang
# COSYVOICE_FORMAT=wav           # wav/mp3/pcm/opus
# COSYVOICE_SAMPLE_RATE=22050
# COSYVOICE_VOLUME=50
# COSYVOICE_RATE=1.0
# COSYVOICE_PITCH=1.0
# COSYVOICE_TIMEOUT=60

# 图生视频网关（只填到主机，不带 /v1/async/chat）
IMAGE2VIDEO_URL=xxxx
IMAGE2VIDEO_API_KEY=xxxx
IMAGE2VIDEO_MODEL=doubao-seedance-1.0-lite-i2v

# ---------- 图生视频服务选择 ----------
# gateway：使用上面的 IMAGE2VIDEO_* 网关；dashscope：使用阿里云百炼（推荐）
# PBSC_I2V_PROVIDER=gateway
# 阿里云百炼密钥只放在这里或系统环境变量，不要写进代码、前端或聊天记录。
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# DASHSCOPE_WORKSPACE_ID=          # 可选：百炼业务空间 ID；不确定就留空
# PBSC_DASHSCOPE_REGION=cn-beijing
# PBSC_DASHSCOPE_MODEL=wan3.0-video-prime
# PBSC_DASHSCOPE_RESOLUTION=1080P  # 480P/720P/1080P；要 1080P 成片时同时设置下面的视频宽高
# PBSC_DASHSCOPE_MEDIA_PROTOCOL=auto  # auto/media/image_url；wan3、wan2.7-i2v 默认 media
# PBSC_DASHSCOPE_RATIO=adaptive
# PBSC_DASHSCOPE_PROMPT_EXTEND=1
# PBSC_DASHSCOPE_WATERMARK=0
# PBSC_DASHSCOPE_TIMEOUT=300       # 单次等待视频生成的秒数
# PBSC_DASHSCOPE_POLL_INTERVAL=1   # 轮询任务状态的初始间隔（秒）
# PBSC_DASHSCOPE_MAX_INTERVAL=3    # 轮询退避上限；越小越快发现完成，但请求更多
# DASHSCOPE_BASE_URL=              # 可选：workspace 专属的 /api/v1 地址；一般填 Workspace ID 即可

# ---------- VLM 内容理解（同学模型；Key 只放本地）----------
# VLM_API_URL=                  # OpenAI 兼容 /chat/completions 或同学自建服务地址
# VLM_API_KEY=xxxx              # 没有鉴权就留空；不要把 Key 发到聊天/文档
# VLM_MODEL=                    # 模型名，例如 qwen3-vl-30b-a3b-instruct
# 也可以沿用赛题参考代码 config.py 的变量名：IMAGE_ANALYSIS_URL / IMAGE_API_KEY / IMAGE_MODEL
# PBSC_VLM_PROTOCOL=openai_chat # openai_chat / custom_json
# PBSC_VLM_BBOX_FORMAT=xyxy     # xyxy / xywh / xyxy_1000（0-1000）/ xyxy_normalized（0-1）
# PBSC_VLM_TIMEOUT=120
# PBSC_VLM_MAX_IMAGE_SIDE=1280  # 发给 VLM 前缩图的最大边；坐标会换算回原图
# PBSC_VLM_AUTO=0               # 上传后是否自动提交整本 VLM 任务

# ---------- 本地语音识别（SenseVoice ONNX，不需要密钥）----------
# PBSC_ASR_MODEL_DIR=data/models/sensevoice  # 模型目录；默认 <PBSC_DATA_DIR>/models/sensevoice
# PBSC_ASR_LANGUAGE=auto        # auto/zh/en/yue/ja/ko/nospeech
# PBSC_ASR_USE_ITN=1            # 数字、时间等逆文本规范化
# PBSC_ASR_INTRA_THREADS=4      # ONNX Runtime CPU 线程数
# PBSC_ASR_MAX_SECONDS=60       # 单次识别音频时长上限

# ---------- 本地 OCR（RapidOCR，不需要密钥）----------
# PBSC_OCR_ENGINE=onnxruntime   # 目前只支持 onnxruntime
# PBSC_OCR_MODEL_DIR=data/models/rapidocr  # 模型目录；默认 <PBSC_DATA_DIR>/models/rapidocr
# PBSC_OCR_TEXT_SCORE=0.5       # 文字置信度阈值，越低召回越多、噪声也越多
# PBSC_OCR_USE_CLS=1            # 是否做 180° 方向分类
# PBSC_OCR_AUTO=1               # 上传后是否自动提交整本 OCR 任务

# ---------- 本项目设置（都有默认值，按需修改）----------
# PBSC_HOST=127.0.0.1            # 平板联调时改为 0.0.0.0
# PBSC_PORT=8000
# PBSC_WEB_DIR=前端
# PBSC_INSTALL_SAMPLE=1         # 空书库首次启动时导入自制示例
# PBSC_VOICE_SERVICE_URL=http://127.0.0.1:8001  # 可选独立音色服务；勿指向主站自身
# PBSC_MAX_UPLOAD_MB=20          # 单个上传文件的大小上限
# PBSC_TASK_WORKERS=2            # 同时执行的生成任务数
# PBSC_RETRY_ATTEMPTS=3          # 外部服务调用失败时的最多尝试次数
# PBSC_NARRATION_MAX_CHARS=220   # 单页旁白字数上限
# PBSC_TTS_VOICE=xiaosi
# PBSC_I2V_CLIP_SECONDS=5        # 图生视频单段时长
# PBSC_I2V_IMAGE_MODE=base64     # base64：直接传图；url：传公网地址（需下面的 PBSC_PUBLIC_BASE_URL）
# PBSC_PUBLIC_BASE_URL=          # 本服务的公网地址，例如 https://demo.example.com
# PBSC_VIDEO_WIDTH=1280          # 要 1080P 成片时设为 1920
# PBSC_VIDEO_HEIGHT=720          # 要 1080P 成片时设为 1080
# PBSC_VIDEO_CROSSFADE=0.5       # 页间转场秒数
# PBSC_SUBTITLE_FONT=            # 字幕字体文件的绝对路径；不填则自动找 Noto Sans SC 等
# PBSC_PRICING_FILE=configs/pricing.json

# 默认不将旁白字幕烧录到视频，避免遮挡原书文字；设为 1 可开启。
PBSC_VIDEO_SUBTITLES=0
